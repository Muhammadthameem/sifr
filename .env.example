# ==============================================================================
# SIFR ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and customize values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# A. REQUIRED CONFIGURATION (Active Application Core)
# ------------------------------------------------------------------------------

# PostgreSQL connection string (Embedded Postgres locally, or managed cloud DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sifr?schema=public"

# Secret key used for signing administrative JWT session cookies (min 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"

# Initial admin credentials used by database seed (`npm run db:seed`)
ADMIN_EMAIL="admin@sifr.in"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword123!"


# ------------------------------------------------------------------------------
# B. OPTIONAL APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------

# Public storefront URL for building customer links in WhatsApp messages
# In production: https://sifr.in (defaults to http://localhost:3000 if unset)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp Business destination phone number for customer orders (country code, no '+')
# Defaults to StoreSettings in DB or fallback phone if omitted
WHATSAPP_BUSINESS_PHONE="919876543210"
NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE="919876543210"

# Secret token required to trigger automated background cron endpoints (Bearer auth)
# Used by /api/tasks/cleanup-reservations and /api/tasks/process-notifications
CRON_SECRET="replace-with-secure-cron-secret-token"

# Automated notification provider for outbound dispatch outbox: MOCK | TWILIO | META
# Note: Active customer ordering uses direct wa.me chat links, which requires no API key.
WHATSAPP_PROVIDER="MOCK"

# Twilio Credentials (only required if WHATSAPP_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID="AC_dummy_twilio_account_sid"
TWILIO_AUTH_TOKEN="dummy_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Meta WhatsApp Cloud API Credentials (only required if WHATSAPP_PROVIDER=META)
META_PHONE_NUMBER_ID="dummy_meta_phone_number_id"
META_WHATSAPP_ACCESS_TOKEN="dummy_meta_access_token"


# ------------------------------------------------------------------------------
# C. LEGACY / DEPRECATED / RETAINED FOR COMPATIBILITY
# ------------------------------------------------------------------------------

# Legacy Payment Gateway (Customer checkout uses WhatsApp ordering; retained for compatibility)
RAZORPAY_KEY_ID="rzp_test_dummy_key_id"
RAZORPAY_KEY_SECRET="dummy_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="dummy_razorpay_webhook_secret"

# Legacy Shipping Cap fallback
# Note: Shipping rates are authoritatively managed via Product.shippingCharge and StoreSettings.globalShippingCap
GLOBAL_SHIPPING_CAP="150"
